################################################################################
#
#  MIVIA Rover - Runtime Environment Configuration
#  File: mivia_rover.env
#  Version: 1.1
#  Last Updated: January 2026
#
################################################################################


# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Bringup parameters
ROS_DISTRO=humble
MIVIA_ENABLE_VIZ=false
MIVIA_BRINGUP_PACKAGE=mivia_rover_bringup
MIVIA_BRINGUP_LAUNCH=launch.py
# enable can bus interface on bringup
ENABLE_CAN_BUS=true
# Velodyne VLP-16 LiDAR wired network.
# The sensor ships on a fixed IP (factory default 192.168.1.201/24) and streams
# UDP to the host; set_network.sh brings up LIDAR_IFACE with a static address in
# the same subnet via a persistent NetworkManager profile ("mivia-lidar").
# Set ENABLE_LIDAR_NET=false to skip this (e.g. bench runs without the LiDAR).
# LIDAR_IFACE must be the Jetson's wired NIC the LiDAR is plugged into
# (check with `ip link`); if the interface is absent the step is skipped.
ENABLE_LIDAR_NET=true
LIDAR_IFACE=eno1
LIDAR_HOST_IP=192.168.1.100/24
LIDAR_DEVICE_IP=192.168.1.201
# WiFi automatic connection parameters
WIFI_AUTO_CONNECT=true
WIFI_SSID="miviarover5G"
WIFI_PASSWORD="mivialab00"
WIFI_IFNAME="wlP1p1s0"
WIFI_TIMEOUT=60